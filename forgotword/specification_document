## 18. Pseudocode (Swift-like)

```swift
struct Profile {
    let name: String
    let multiplier: Double
}

let baseDays = [0, 1, 3, 7, 16, 35, 90]

func nextDueDates(from created: Date, profile: Profile) -> [Date] {
    baseDays.map { days in
        let adjusted = days * profile.multiplier
        return alignToNextBatch(from: created.addingTimeInterval(adjusted * 86400))
    }
}
```

